LLM_PROVIDER=openrouter

# Required for OpenRouter
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Optional OpenRouter settings
OPENROUTER_MODEL=openai/gpt-5.2
OPENROUTER_SITE_URL=http://localhost
OPENROUTER_SITE_NAME=tiny-rag-bot
OPENROUTER_TIMEOUT=60

# Required for Hugging Face Inference API (free tier, rate-limited)
HF_API_TOKEN=hf_your_token_here

# Optional Hugging Face settings
HF_MODEL=mistralai/Mistral-7B-Instruct-v0.2
# HF_API_URL=https://router.huggingface.co/v1/chat/completions
HF_TIMEOUT=60
HF_MAX_NEW_TOKENS=256
HF_TEMPERATURE=0.2
HF_TOP_P=0.9
HF_DO_SAMPLE=false
HF_WAIT_FOR_MODEL=true
HF_MAX_RETRIES=3
HF_RETRY_DELAY_SECONDS=10

# Optional local fallback model when LLM_PROVIDER=local_t5
LOCAL_T5_MODEL=google/flan-t5-small